# Copy to .env and fill in.
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Data directory (relative to the repo root, or absolute)
DATA_DIR=./data

# Bounding box of the Amazon biome (west,south,east,north); the exact clip uses REGION_BOUNDARY
REGION_BBOX=-74.0,-16.7,-43.9,5.3

# Optional: GeoJSON with the exact boundary (e.g. the RAISG limit or the IBGE biome).
# If the file exists, hotspots are clipped to it in addition to the bbox.
REGION_BOUNDARY=./data/boundaries/amazonia.geojson

# Frontend CORS in dev
CORS_ORIGINS=http://localhost:5173
