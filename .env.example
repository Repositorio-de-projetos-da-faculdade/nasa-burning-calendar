# Copie para .env e preencha.
# MAP_KEY gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Diretorio de dados (relativo a raiz do repo, ou absoluto)
DATA_DIR=./data

# Envelope do bioma Amazonia (west,south,east,north); o recorte fino usa REGION_BOUNDARY
REGION_BBOX=-74.0,-16.7,-43.9,5.3

# Opcional: GeoJSON com o limite exato (ex.: limite RAISG ou bioma IBGE).
# Se o arquivo existir, os focos sao recortados por ele alem do bbox.
REGION_BOUNDARY=./data/boundaries/amazonia.geojson

# CORS do frontend em dev
CORS_ORIGINS=http://localhost:5173
